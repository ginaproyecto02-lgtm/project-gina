  },
  "permisos_api": [
    {
      "permiso": "storage",
      "para_que": "Guardar preferencias de usuario, estado de bienvenida, seguimiento local de precios objetivo, caché local de IA, historial de precios, marcas pendientes y diagnósticos técnicos en el navegador.",
      "why": "Store user preferences, onboarding status, local target price tracking, local AI cache, price history, pending unknown brands, and technical diagnostics inside the browser.",
      "archivo_que_lo_usa": "src/background.js, src/content.js, src/card.js, options/options.js, popup/popup.js",
      "obligatorio": true
    },
    {
      "permiso": "alarms",
      "para_que": "Programar la comprobación periódica de la base de datos descargada y la sincronización de sugerencias pendientes.",
      "why": "Schedule periodic checks for database updates and pending suggestion queue synchronizations.",
      "archivo_que_lo_usa": "src/background.js",
      "obligatorio": true
    },
    {
      "permiso": "offscreen",
      "para_que": "Crear un contexto offscreen en Chromium para procesamiento DOM de diagnóstico y análisis en segundo plano sin interrumpir la página.",
      "why": "Create an offscreen document context in Chromium for background DOM parsing and diagnostic tasks without blocking navigation.",
      "archivo_que_lo_usa": "src/background.js",
      "obligatorio": true
    }
  ],
  "host_permissions": [
    {
      "permiso": "https://script.google.com/*",
      "para_que": "Enviar sugerencias anónimas de marcas y alternativas comunitarias a la aplicación web privada de Google Apps Script del proyecto.",
      "why": "Send voluntary, anonymous brand and alternative suggestions to the project private Google Apps Script Web App.",
      "archivo_que_lo_usa": "src/background.js",
      "obligatorio": true
    },
    {
      "permiso": "https://script.googleusercontent.com/*",
      "para_que": "Seguir redirecciones seguras de Google Apps Script al procesar sugerencias anónimas de marcas.",
      "why": "Follow secure HTTP redirects from Google Apps Script when submitting anonymous brand suggestions.",
      "archivo_que_lo_usa": "src/background.js",
      "obligatorio": true
    }
  ],
  "optional_host_permissions": [
    {
      "permiso": "https://api.anthropic.com/*",
      "para_que": "Consultar la API de Anthropic (Claude) cuando el usuario activa voluntariamente la investigación con su propia clave de API.",
      "why": "Query the Anthropic Claude API only when the user voluntarily enables AI features using their own API key.",
      "archivo_que_lo_usa": "src/ai.js, src/background.js",
      "obligatorio": false
    },
    {
      "permiso": "https://generativelanguage.googleapis.com/*",
      "para_que": "Consultar la API de Google Gemini cuando el usuario activa voluntariamente la investigación con su propia clave de API.",
      "why": "Query the Google Gemini API only when the user voluntarily enables AI features using their own API key.",
      "archivo_que_lo_usa": "src/ai.js, src/background.js",
      "obligatorio": false
    },
    {
      "permiso": "https://api.groq.com/*",
      "para_que": "Consultar la API de Groq cuando el usuario activa voluntariamente la investigación con su propia clave de API.",
      "why": "Query the Groq API only when the user voluntarily enables AI features using their own API key.",
      "archivo_que_lo_usa": "src/ai.js, src/background.js",
      "obligatorio": false
    },
    {
      "permiso": "https://api.x.ai/*",
      "para_que": "Consultar la API de xAI cuando el usuario activa voluntariamente la investigación con su propia clave de API.",
      "why": "Query the xAI API only when the user voluntarily enables AI features using their own API key.",
      "archivo_que_lo_usa": "src/ai.js, src/background.js",
      "obligatorio": false
    },
    {
      "permiso": "https://*/*",
      "para_que": "Permitir al comparador de precios consultar tiendas del país del usuario, solicitado bajo demanda por tienda con consentimiento explícito en options/comparar.html.",
      "why": "Allow the in-card price comparator to look up matching items across local stores, requested on demand per store with explicit consent.",
      "archivo_que_lo_usa": "src/comparador.js, options/comparar.js",
      "obligatorio": false
    }
  ],
